---
// Gavekort-promo. Gjenbrukes på flere sider, uten eget menypunkt.
// Lenker til gavekortsiden i nettbutikken (kjøp + "ønsk deg dette").
//
// Juletekst vises automatisk fra 1. november til 24. desember. Det styres av
// et lite skript i Layout.astro som setter data-jul på <html>, så det virker
// også på statisk bygde sider uten ny deploy.
//
// variant="band"   : kort med tekst og knapp (standard)
// variant="inline" : diskret lenke, f.eks. under knappene i hero
interface Props { variant?: 'band' | 'inline'; }
const { variant = 'band' } = Astro.props;

const isEn = Astro.url.pathname.startsWith('/en');
const shopUrl = isEn
  ? 'https://booking.mobulamusic.no/en/gavekort'
  : 'https://booking.mobulamusic.no/gavekort';
// ?onske åpner skjemaet for ønsketips direkte i nettbutikken
const wishUrl = `${shopUrl}?onske`;

const t = isEn
  ? {
      eyebrow: 'Gift card',
      eyebrowJul: 'Christmas gift idea',
      title: 'Give studio time, or wish for it',
      titleJul: 'Give studio time for Christmas',
      body: 'A gift card for recording, mixing, mastering or any other service we offer.',
      cta: 'Buy a gift card',
      wish: 'Wish for this',
      wishHelp: 'Would you like studio time yourself? Send a hint and we will email whoever is giving the gift.',
      inline: 'Give or wish for studio time',
      inlineJul: 'Christmas gift idea: Give or wish for studio time',
    }
  : {
      eyebrow: 'Gavekort',
      eyebrowJul: 'Julegaveidé',
      title: 'Gi bort studiotid, eller ønsk deg det',
      titleJul: 'Gi bort studiotid til jul',
      body: 'Gavekort på innspilling, miksing, mastering eller en hvilken som helst annen tjeneste hos oss.',
      cta: 'Kjøp gavekort',
      wish: 'Ønsk deg dette',
      wishHelp: 'Vil du selv ha studiotid? Send et hint, så sender vi en e-post til den som skal gi gaven.',
      inline: 'Gi bort eller ønsk deg studiotid',
      inlineJul: 'Julegaveidé: Gi bort eller ønsk deg studiotid',
    };
---

{variant === 'inline' ? (
  <a
    href={shopUrl}
    target="_blank"
    rel="noopener"
    class="group inline-flex items-center gap-2.5 rounded-full border border-gold/30 bg-dark/40 backdrop-blur-sm pl-2 pr-4 py-1.5 text-sm text-cream/85 hover:border-gold hover:text-gold transition-colors"
  >
    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-gold/15 text-xs leading-none" aria-hidden="true">🎁</span>
    <span class="jul-off">{t.inline}</span>
    <span class="jul-on">{t.inlineJul}</span>
    <span class="text-gold transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
  </a>
) : (
  <section class="px-6 py-16 md:py-20">
    <div class="max-w-5xl mx-auto fade-in">
      <div class="card-glass card-hover rounded-lg relative overflow-hidden">
        <!-- Accent glows (mint + lavender), mirroring the site's hero -->
        <div class="absolute -top-16 -right-10 w-64 h-64 rounded-full blur-[90px] bg-gold/10 pointer-events-none" aria-hidden="true"></div>
        <div class="absolute -bottom-20 -left-12 w-64 h-64 rounded-full blur-[90px] bg-[color:var(--color-accent-2)]/10 pointer-events-none" aria-hidden="true"></div>

        <div class="relative flex flex-col md:flex-row md:items-center gap-7 md:gap-9 p-8 md:p-10">
          <span class="shrink-0 inline-flex items-center justify-center w-14 h-14 rounded-full bg-gold/10 ring-1 ring-gold/30 text-3xl leading-none" aria-hidden="true">🎁</span>

          <div class="flex-1">
            <p class="font-mono text-gold tracking-[0.15em] uppercase text-xs mb-2">
              <span class="jul-off">{t.eyebrow}</span><span class="jul-on">{t.eyebrowJul}</span>
            </p>
            <h2 class="text-2xl md:text-3xl font-serif font-semibold leading-tight mb-3">
              <span class="jul-off">{t.title}</span><span class="jul-on">{t.titleJul}</span>
            </h2>
            <p class="text-cream/70 text-sm md:text-base leading-relaxed max-w-xl">{t.body}</p>
            <p class="mt-3 text-cream/60 text-sm leading-relaxed max-w-xl">
              {t.wishHelp}
            </p>
          </div>

          <div class="shrink-0 flex flex-col sm:flex-row md:flex-col gap-3 md:items-stretch">
            <a
              href={shopUrl}
              target="_blank"
              rel="noopener"
              class="group inline-flex items-center justify-center gap-3 px-7 py-3.5 bg-gold text-dark font-semibold tracking-wide uppercase text-sm rounded-sm hover:bg-gold-light transition-colors whitespace-nowrap"
            >
              {t.cta}
              <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
            <a
              href={wishUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center gap-2 px-7 py-3.5 border border-gold/40 text-cream tracking-wide uppercase text-sm rounded-sm hover:border-gold hover:text-gold transition-colors whitespace-nowrap"
            >
              <span aria-hidden="true">🎁</span> {t.wish}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
)}
